{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AburráSegura: backend",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --reload",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^__never__$" },
        "background": { "activesBegin": "Will watch|Started reloader", "endsPattern": "Application startup complete" }
      },
      "presentation": { "group": "aburra", "panel": "dedicated" }
    },
    {
      "label": "AburráSegura: frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^__never__$" },
        "background": { "activesBegin": "vite", "endsPattern": "Local:" }
      },
      "presentation": { "group": "aburra", "panel": "dedicated" }
    },
    {
      "label": "AburráSegura: iniciar todo",
      "dependsOn": ["AburráSegura: backend", "AburráSegura: frontend"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "AburráSegura: pruebas",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe -m pytest -q",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "AburráSegura: reconstruir base de datos",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe scripts/build_database.py",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
